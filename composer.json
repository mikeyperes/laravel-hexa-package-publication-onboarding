{
    "name": "hexawebsystems/laravel-hexa-package-publication-onboarding",
    "version": "0.1.0",
    "description": "Reusable Laravel domain engine for planning, applying, verifying, reconciling, and rolling back publication onboarding.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "hexa_package_publication_onboarding\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "hexa_package_publication_onboarding\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "hexa_package_publication_onboarding\\Providers\\PublicationOnboardingServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
